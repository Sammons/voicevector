<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Hardened-runtime entitlements (Developer ID signing / notarization).
         Not sandboxed: CGEvent posting and the global event tap require it. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <!-- AppleScript paste fallback (System Events keystroke). -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
</dict>
</plist>
