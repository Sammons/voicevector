<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- .NET Framework 4.8 ships inside Windows 10/11: single small exe,
         nothing for users to install, ever. -->
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>7.3</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>VoiceVector</AssemblyName>
    <RootNamespace>VoiceVector.Win</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <Prefer32Bit>false</Prefer32Bit>
    <!-- Compile-check from non-Windows hosts (reference assemblies only). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <InformationalVersion Condition="'$(InformationalVersion)' == ''">0.0.0-dev</InformationalVersion>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Shared/**/*.cs" LinkBase="Shared" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Security" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>
</Project>
